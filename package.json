{
  "name": "magister-swp",
  "version": "3.0.0",
  "private": true,
  "description": "Лабораторні роботи з дисципліни «Серверне WEB-програмування»",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 'test/**/*.test.js'",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.js up",
    "db:rollback": "node --env-file-if-exists=.env src/db/migrate.js down",
    "screenshots": "node --env-file-if-exists=.env scripts/screenshots.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "swagger-ui-express": "^5.0.1",
    "umzug": "^3.8.3",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "puppeteer-core": "^25.13.0"
  }
}
