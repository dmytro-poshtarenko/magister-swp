# Скопіюйте у .env і задайте власний пароль: cp .env.example .env
PORT=3000

DB_HOST=localhost
DB_PORT=5442
DB_NAME=magister_swp
DB_TEST_NAME=magister_swp_test
DB_USER=magister
DB_PASSWORD=change-me
# true виводить у консоль кожен SQL-запит, який будує Sequelize
DB_LOGGING=false

ADMINER_PORT=8081

# Секрет для підпису JWT, щонайменше 32 символи: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string-of-64-characters
# Час дії токена доступу, секунди
JWT_EXPIRES_IN=3600

# Адміністратор, якого сервер створює під час запуску, якщо його ще немає
ADMIN_NAME=Адміністратор
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# Рівень логування: error, warn, info або debug
LOG_LEVEL=info
# Адреса Grafana Loki; без неї логи виводяться лише в консоль
LOKI_URL=http://localhost:3100
LOKI_PORT=3100
GRAFANA_PORT=3001
